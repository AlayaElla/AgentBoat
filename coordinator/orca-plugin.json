{
  "manifestVersion": 2,
  "id": "project-coordinator",
  "name": "项目协作",
  "version": "0.1.0",
  "description": "分项目处理决定与成果验收，保存任务记录并接收飞书消息。",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/worker.mjs",
  "contributes": {
    "settings": [{ "key": "cliPath", "title": "Orca CLI 路径", "type": "string", "default": "" }],
    "statusBarItems": [{ "id": "coordinator", "text": "项目协作", "icon": "blocks" }],
    "panels": [
      {
        "id": "project-coordinator",
        "title": "项目协作",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "secrets:own" },
    { "kind": "settings:own" },
    { "kind": "workspace:write" }
  ]
}
